":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2jj_VscEeSKT","executionInfo":{"status":"ok","timestamp":1755001539604,"user_tz":-330,"elapsed":18,"user":{"displayName":"Aman Ahuja","userId":"03395291107840602417"}},"outputId":"e67c9979-45eb-458d-d129-9d87db613a41"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["['RELIANCE.NS',\n"," 'BHARTIARTL.NS',\n"," 'TCS.NS',\n"," 'HCLTECH.NS',\n"," 'MARUTI.NS',\n"," 'INFY.NS',\n"," 'HEROMOTOCO.NS',\n"," 'COALINDIA.NS',\n"," 'HINDUNILVR.NS',\n"," 'ASIANPAINT.NS']"]},"metadata":{},"execution_count":158}]},{"cell_type":"code","execution_count":null,"metadata":{"id":"xAoYo0ryU08H"},"outputs":[],"source":["#  Formulate Views\n","# View 1: stock 1 will outperform stock2 by 2%\n","# View 2: stock3 will underperform stock4 by 3%\n","# View 3: stock4 will outperform stock5 by 1.5%\n","P = np.zeros((3, len(stocks)))\n","P[0, stocks.index(stocks[0])] = 1\n","P[0, stocks.index(stocks[1])] = -1\n","P[1, stocks.index(stocks[2])] = -1\n","P[1, stocks.index(stocks[3])] = 1\n","P[2, stocks.index(stocks[4])] = 1\n","P[2, stocks.index(stocks[5])] = -1\n","\n","Q = np.array([0.02, -0.03, 0.015])"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"0km9Hl6BVMjA"},"outputs":[],"source":["\n","#  Omega matrix (view uncertainty)\n","Omega = np.diag([0.0001, 0.0001, 0.0001])  # TODO: Fill in based on confidence (e.g. 0.0001)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"0EcCS8bDVNCZ"},"outputs":[],"source":["# Black-Litterman Posterior\n","def black_litterman_posterior(cov, pi, P, Q, Omega, tau=0.025):\n","    # τΣ: scaled prior covariance\n","    # μ_bl = [(τΣ)^(-1) + PᵀΩ⁻¹P]^(-1) * [(τΣ)^(-1)π + PᵀΩ⁻¹Q]\n","    # Σ_bl = [(τΣ)^(-1) + PᵀΩ⁻¹P]^(-1)\n","    tau_cov = tau * cov\n","\n","    inv_tau_cov = np.linalg.inv(tau_cov)\n","    inv_Omega = np.linalg.inv(Omega)\n","\n","    M = np.linalg.inv(inv_tau_cov + P.T @ inv_Omega @ P)\n","    mu_bl = M @ (inv_tau_cov @ pi + P.T @